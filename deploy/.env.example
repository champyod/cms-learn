# Copy to `.env` (never commit it), fill every value, then `chmod 600 .env`.
#
# Nothing here is a default that is safe to ship: the `:?` guards in docker-compose.yml make the
# stack refuse to start when a required value is missing, rather than booting with a placeholder.

# ── identity ──────────────────────────────────────────────────────────────────────────────────
DOMAIN=learn.example.com
ACME_EMAIL=you@example.com

# ── images ────────────────────────────────────────────────────────────────────────────────────
# Dev: a tag. Production: pin digests (docker compose config --images | xargs docker image inspect
# ... | grep RepoDigests), because a tag can be moved under you and a digest cannot.
TAG=dev

# ── database ──────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=cmslearn
POSTGRES_USER=cmslearn
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── accounts ──────────────────────────────────────────────────────────────────────────────────
# Registration is an operator switch: close it once the class is enrolled and nobody else can create
# an account. Approval is a second switch: with it on, a new account exists but cannot do anything
# until a teacher approves it.
REGISTRATION_OPEN=true
APPROVAL_REQUIRED=true
# Comma-separated. Empty means "no domain restriction" — only acceptable while approval is ON.
ALLOWED_EMAIL_DOMAINS=
SESSION_TTL_MINUTES=720

# ── edge security ─────────────────────────────────────────────────────────────────────────────
# Create once, after first boot: docker compose exec crowdsec cscli bouncers add caddy-proxy -o raw
CROWDSEC_API_KEY=

# ── observability ─────────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 24
GRAFANA_PASSWORD=

# ── backups ───────────────────────────────────────────────────────────────────────────────────
# The private key stays OFF this server. If the host is lost and the key was on it, the dumps are
# noise. Generate on your laptop: age-keygen -o cms-learn-backup.key
AGE_PUBLIC_KEY=
# rclone remote:path, or a mounted school share. Empty disables the offsite copy (local volume only).
BACKUP_REMOTE=
BACKUP_RETAIN_DAYS=7

# ── judge ─────────────────────────────────────────────────────────────────────────────────────
# Must match the delegation the operator prepared on the host (see deploy/README.md).
ISOLATE_CGROUP_PATH=/sys/fs/cgroup/cms-learn-isolate
