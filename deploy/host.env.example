# The api's host file: the facts the service cannot invent, and the only thing it reads at startup.
#
# Copy to `deploy/host.env` (gitignored), fill every value, then `chmod 600 deploy/host.env`. A value
# left empty stops the service with one message naming every key that is wrong; it never starts on a
# guess, and it never prints a value back — the seal key is in this file.
#
# The addresses below are the container's, not the host's: Caddy reaches the api over the `edge`
# network, so the listeners bind 0.0.0.0 inside the container. No port in this file is published.

CMSLEARN_LISTEN_ADDRESS=0.0.0.0
CMSLEARN_LISTEN_PORT=8080

# The administrator panel. Setting both keys is what mounts the panel at all: with them empty the
# service runs the public site and keeps no panel. The port must stay 8081, because the panel answers
# only the listener the request arrived on; deploy/Caddyfile routes /admin to this port, and /admin on
# 8080 answers 404 by design.
CMSLEARN_PANEL_LISTEN_ADDRESS=0.0.0.0
CMSLEARN_PANEL_LISTEN_PORT=8081

# Must agree with POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB in deploy/.env, and name the
# `database` service rather than a host address.
CMSLEARN_DATABASE_URL=postgres://cmslearn:CHANGE_ME@database:5432/cmslearn

# Generate: openssl rand -base64 32
# At least 32 bytes. It encrypts the settings rows whose catalogue tier is `secret`.
CMSLEARN_SEAL_KEY=

# The operator account the database bootstrap creates, once, on an empty database.
CMSLEARN_BOOTSTRAP_ADMIN=

# proxy: TLS ends at Caddy, the only service that faces the internet.
CMSLEARN_TLS_MODE=proxy

# The socket the command line talks to, inside the container. /tmp is the one directory the image's
# unprivileged user can create it in without a writable volume.
CMSLEARN_ADMIN_SOCKET=/tmp/cms-learn-admin.sock

# The only uid allowed to open that socket: the user the api image runs as.
CMSLEARN_ADMIN_UID=10001

# Where the read-only mounts declared in deploy/stack.template.yml land. The binary resolves these,
# and its settings catalogue, as paths inside the tree it was compiled in, so the layout below mirrors
# that tree rather than inventing new names.
CMSLEARN_TEMPLATE_ROOT=/src/api/templates
CMSLEARN_STATIC_ROOT=/src/web/public
