{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cms-learn.local/schema/modules.schema.json",
  "title": "Module set",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "areas", "modules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string" },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^a-[a-z0-9-]+$" },
          "title": { "$ref": "#/definitions/label" }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "title", "topics", "prereqs"],
        "properties": {
          "id": { "type": "string", "pattern": "^m-[a-z0-9-]+$" },
          "area": { "type": "string", "pattern": "^a-[a-z0-9-]+$" },
          "title": { "$ref": "#/definitions/label" },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "prereqs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^m-[a-z0-9-]+$" }
          }
        }
      }
    }
  },
  "definitions": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "th"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "th": { "type": "string", "minLength": 1 }
      }
    }
  }
}
