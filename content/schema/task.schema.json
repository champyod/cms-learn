{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cms-learn.local/schema/task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "title",
    "level",
    "topics",
    "difficulty",
    "locales",
    "limits",
    "checker",
    "origin",
    "verification"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "verified", "published", "rejected"] },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "th"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "th": { "type": "string", "minLength": 1 }
      }
    },
    "level": { "type": "string", "pattern": "^s[0-9]-[a-z0-9-]+$" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "difficulty": { "type": "integer", "minimum": 800, "maximum": 3500, "multipleOf": 100 },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["en", "th"] }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_ms", "memory_mb"],
      "properties": {
        "time_ms": { "type": "integer", "minimum": 100, "maximum": 20000 },
        "memory_mb": { "type": "integer", "minimum": 16, "maximum": 1024 }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["standard", "token", "testlib", "interactive"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "testdata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "cases": { "type": "integer", "minimum": 1 }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["original", "imported", "ai"] },
        "pipeline": { "type": "string" },
        "source": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference_solution", "methods"],
      "properties": {
        "status": { "enum": ["pending", "verified", "failed"] },
        "reference_solution": { "type": "string", "minLength": 1 },
        "methods": {
          "type": "array",
          "items": { "enum": ["reference-pass", "bruteforce-differential", "limits-measured"] }
        },
        "verified_at": { "type": "string", "minLength": 10 }
      }
    }
  }
}
