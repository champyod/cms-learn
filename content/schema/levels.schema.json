{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cms-learn.local/schema/levels.schema.json",
  "title": "Levels",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "levels"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "min", "max"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en"],
            "properties": { "en": { "type": "string", "minLength": 1 } }
          },
          "min": { "type": "integer", "minimum": 800, "maximum": 3500, "multipleOf": 100 },
          "max": { "type": "integer", "minimum": 800, "maximum": 3500, "multipleOf": 100 }
        }
      }
    }
  }
}
