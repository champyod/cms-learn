{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cms-learn.local/schema/curriculum.schema.json",
  "title": "Curriculum tree",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sections"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "definitions": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "th"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "th": { "type": "string", "minLength": 1 }
      }
    },
    "topicList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "topics", "prereqs"],
      "properties": {
        "id": { "type": "string", "pattern": "^m-[a-z0-9-]+$" },
        "title": { "$ref": "#/definitions/label" },
        "topics": { "$ref": "#/definitions/topicList" },
        "prereqs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^m-[a-z0-9-]+$" }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "modules"],
      "properties": {
        "id": { "type": "string", "pattern": "^c-[a-z0-9-]+$" },
        "title": { "$ref": "#/definitions/label" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/module" }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "categories"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]-[a-z0-9-]+$" },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "$ref": "#/definitions/label" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/category" }
        }
      }
    }
  }
}
