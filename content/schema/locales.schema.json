{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cms-learn.local/schema/locales.schema.json",
  "title": "Locales",
  "description": "Every language a task may ship: the tag its statement file carries, and the name a prompt says when it asks for that language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "locales"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "name"],
        "properties": {
          "tag": { "type": "string", "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
